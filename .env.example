# ─────────────────────────────────────────────────────────────
# VARIABLES DE ENTORNO — WhatsApp Data Collector Bot v2
# ─────────────────────────────────────────────────────────────
# Copia este archivo como ".env" y rellena tus valores reales.
# NUNCA subas el archivo .env a Git (ya está en .gitignore).
# ─────────────────────────────────────────────────────────────

# ── Proveedor activo de IA ────────────────────────────────────
# Valores posibles: gemini | openai | ollama
AI_PROVIDER=gemini

# ── Google Gemini ─────────────────────────────────────────────
# Consigue tu API Key gratis en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── OpenAI (para uso futuro) ──────────────────────────────────
# OPENAI_API_KEY=your_openai_api_key_here

# ── Ollama (para uso futuro, sin API key) ─────────────────────
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3

# ── Evolution API ─────────────────────────────────────────────
# URL base de tu instancia de Evolution API (sin barra final al final)
# Ejemplo: http://localhost:8080  |  https://evolution.tudominio.com
EVOLUTION_BASE_URL=http://localhost:8080

# Token de autenticación (configurado en el servidor de Evolution API)
EVOLUTION_API_KEY=your_evolution_api_key_here

# Nombre de la sesión/instancia creada en Evolution API
# Puedes crearlo con: POST /instance/create
EVOLUTION_INSTANCE_NAME=your_instance_name_here

# ── Servidor de Webhooks local ────────────────────────────────
# Puerto en el que este bot escuchará los eventos de Evolution API.
# Debes configurar en Evolution API el webhook apuntando a:
#   http://<tu-ip-o-dominio>:<WEBHOOK_PORT>/webhook
WEBHOOK_PORT=3000